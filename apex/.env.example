# Keep this file's values private in .env.local. Never put keys in NEXT_PUBLIC variables.
APEX_PROVIDER=gemini
# Gemini is the selected brain; inference requires a private server-side key.
GEMINI_API_KEY=
# Uses the existing preferred low-cost model ID. Change only to a model enabled for your account.
GEMINI_MODEL=gemini-3.5-flash-lite
# This new HTTP runtime uses 8081 so it does not replace your existing WS gateway on 8080.
APEX_RUNTIME_PORT=8081
# Optional: absolute path to a persistent local data directory. Defaults to .apex-data in this project.
# APEX_DATA_DIR=C:\APEX-data

# Maximum simultaneous background jobs (1–3). Foreground chat remains independent.
APEX_BACKGROUND_CONCURRENCY=2

# Local model admission: reserve capacity for conversation.
# Total requests 2–3; background requests at least 1 and less than total.
APEX_INFERENCE_CONCURRENCY=2
APEX_BACKGROUND_INFERENCE_LIMIT=1

# NOVA Fish Audio output; server-only key. Model is fixed to s2.1-pro-free (no paid fallback).
# Selected voice: 3a7bcde726774da88cef935fb2d64da3
FISH_API_KEY=

# APEX cloud voice: permanent API keys stay in this private file.
DEEPGRAM_API_KEY=
# APEX: flux-general-en + Fish Audio s2.1-pro-free (same private FISH_API_KEY above).
# Choose a Fish Audio voice ID for APEX; NOVA retains its own voice.
APEX_FISH_VOICE_ID=cae9af8ace0544c28879587a3496d6f0

# Optional Hermes orchestration. No UI or voice provider changes.
APEX_ORCHESTRATOR=direct
APEX_HERMES_URL=http://127.0.0.1:8642
APEX_HERMES_API_KEY=
APEX_HERMES_TIMEOUT_MS=180000
APEX_HERMES_DAILY_CALL_LIMIT=100
# Enable only after selecting an installed model that really supports >=64K.
# APEX_HERMES_CONTEXT_LENGTH=64000

# Private Google integrations (Gmail, primary Google Calendar, Drive).
# Configure an OAuth Web application with http://127.0.0.1:8094/callback.
# No credentials are sent to the browser. See docs/GOOGLE-CONNECTION.md.
APEX_INTEGRATION_PROVIDER=google
APEX_GOOGLE_CLIENT_ID=
APEX_GOOGLE_CLIENT_SECRET=
APEX_GOOGLE_REFRESH_TOKEN=
# APEX_GOOGLE_ACCESS_TOKEN is supported as a temporary alternative.
